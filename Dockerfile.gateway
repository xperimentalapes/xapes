# Discord Gateway worker only (not the Vercel site).
# Deploy: Railway — docs/deploy-discord-gateway-railway.md
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY lib ./lib
COPY scripts ./scripts

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

CMD ["npm", "run", "royal-bot-gateway"]
