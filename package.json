{
  "name": "xapes",
  "version": "1.0.0",
  "description": "Xperimental Mutant Apes website",
  "scripts": {
    "build": "node scripts/inject-env.js",
    "dev": "npm run build && npm start",
    "start": "NODE_PATH=. node apps/web/server.js",
    "sync-nfts": "node scripts/sync-nfts-roles.js",
    "populate-nfts": "node scripts/populate-nfts.js",
    "backfill-trait-flags": "node scripts/backfill-trait-flags.js",
    "seed-discord-roles": "node scripts/seed-discord-roles.js",
    "extract-traits": "node scripts/extract-trait-values.js",
    "list-body-head-traits": "node scripts/list-body-head-traits.js",
    "register-discord-commands": "node scripts/register-discord-commands.js",
    "royal-bot-gateway": "node scripts/royal-bot-gateway.js",
    "accrue-discord-xma-rewards": "node scripts/accrue-discord-xma-rewards.js",
    "settle-discord-xma-daily": "node scripts/settle-discord-xma-daily.js",
    "daily-xma-grant": "node scripts/apply-daily-xma-grant.js",
    "verify-discord-xma": "node scripts/verify-discord-xma-migrations.js",
    "verify-casino": "node scripts/verify-casino-migrations.js",
    "fly": "sh scripts/fly.sh",
    "fly:login": "sh scripts/fly.sh auth login",
    "fly:launch": "sh scripts/fly.sh launch --no-deploy --copy-config --region iad",
    "fly:logs": "sh scripts/fly.sh logs",
    "fly:status": "sh scripts/fly.sh status",
    "deploy:gateway:fly": "sh scripts/fly.sh deploy"
  },
  "dependencies": {
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.87.6",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/functions": "^1.6.0",
    "axios": "^1.6.0",
    "bs58": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.1.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "tweetnacl": "^1.0.3"
  }
}
